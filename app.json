{
  "expo": {
    "android": {
      "package": "com.pawth.app",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/images/icon-new.png",
    "ios": {
      "bundleIdentifier": "com.pawth.app",
      "supportsTablet": true
    },
    "name": "Pawth",
    "newArchEnabled": true,
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pawth uses your location to find nearby trails and parks for walks with your pet."
        }
      ]
    ],
    "scheme": "pawth",
    "slug": "pawth",
    "splash": {
      "backgroundColor": "#FFF5E6",
      "image": "./assets/images/splash_screen.png",
      "resizeMode": "contain"
    },
    "userInterfaceStyle": "automatic",
    "version": "2.0.0",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "output": "single"
    }
  }
}